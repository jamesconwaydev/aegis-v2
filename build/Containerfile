# Rocky Linux 10 build environment for Aegis. `cargo xtask container`
# builds it; `cargo xtask build` runs every compile inside it.
FROM docker.io/rockylinux/rockylinux:10.2@sha256:827d37bc128288ccf160ee318bb3cb92d591164cb217e92f8bc61e3982ae1834

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

RUN dnf -y install gcc clang llvm rpm-build selinux-policy-devel \
        systemd-rpm-macros git zstd \
    && dnf clean all

# RUST_STABLE must match rust-toolchain.toml. aegisd/build.rs hands
# AEGIS_EBPF_TOOLCHAIN to aya-build, so the eBPF crate always builds with
# this nightly, and its LLVM must be one bpf-linker can read.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    RUST_STABLE=1.99.1 \
    AEGIS_EBPF_TOOLCHAIN=nightly-2026-10-19

# Stable builds and lints userspace; the nightly with rust-src builds the
# eBPF crate (aya-build runs it with -Z build-std=core).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "$RUST_STABLE" \
            --component rust-src,clippy,rustfmt \
    && rustup toolchain install "$AEGIS_EBPF_TOOLCHAIN" --profile minimal \
        --component rust-src

# A source build of bpf-linker needs a system LLVM matching the one in
# rustc nightly, which Rocky does not ship. Upstream's static release
# binary bundles the right LLVM.
ARG BPF_LINKER=v0.12.0
RUN arch=$(uname -m) \
    && case "$arch" in \
        x86_64) sha=6789717c8cb6a2a5d920f3b6bfac2bd7efc00f6228ecd149108a99699a75c679 ;; \
        aarch64) sha=5e201e69dafac7af98f9788f1c68edd5ccc8fa0805093f899bf02bd2947b3935 ;; \
        *) echo "no bpf-linker hash for $arch" >&2; exit 1 ;; \
    esac \
    && f=bpf-linker-$arch-unknown-linux-musl.tar.zst \
    && curl -sSfLo "/tmp/$f" "https://github.com/aya-rs/bpf-linker/releases/download/$BPF_LINKER/$f" \
    && echo "$sha  /tmp/$f" | sha256sum -c - \
    && tar --zstd -xpf "/tmp/$f" -C /usr/local/cargo/bin \
    && rm "/tmp/$f" \
    && bpf-linker --version

# cargo-about writes THIRD-PARTY-LICENSES for the RPM's %license.
ARG CARGO_ABOUT=0.9.2
RUN arch=$(uname -m) \
    && case "$arch" in \
        x86_64) sha=9099a59e820c38a68b9d65f300662a567d56562f9a10f6aa4c7e86c17c2566af ;; \
        aarch64) sha=af5169282fb6f84e13471493f405437e43ac517744c9ae12fbe2cdf0a6f0e5a8 ;; \
        *) echo "no cargo-about hash for $arch" >&2; exit 1 ;; \
    esac \
    && d=cargo-about-$CARGO_ABOUT-$arch-unknown-linux-musl \
    && curl -sSfLo "/tmp/$d.tar.gz" "https://github.com/EmbarkStudios/cargo-about/releases/download/$CARGO_ABOUT/$d.tar.gz" \
    && echo "$sha  /tmp/$d.tar.gz" | sha256sum -c - \
    && tar -xzf "/tmp/$d.tar.gz" -C /usr/local/cargo/bin --strip-components=1 "$d/cargo-about" \
    && rm "/tmp/$d.tar.gz" \
    && cargo about --version
