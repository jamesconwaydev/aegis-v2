[Unit]
Description=Aegis v2 runtime threat detection daemon
Documentation=https://github.com/jamesconwaydev/aegis-v2

[Service]
Type=notify
ExecStart=/usr/sbin/aegisd
# Not `systemctl kill`: that would also signal any rpm query in flight.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# A bad config exits 78 (EX_CONFIG). Restarting won't fix it.
RestartPreventExitStatus=78
# On every stop, crashes included: freeze any tree aegisd was observing
# in honeypot mode, whose holds end with aegisd. aegisd closes those
# observations when it starts again.
ExecStopPost=/usr/libexec/aegis-v2/freeze-quarantine

# Root, holding only what it uses:
#   CAP_BPF, CAP_PERFMON  load the probes, open the tracepoints
#   CAP_SYS_ADMIN         attach the BPF LSM programs
#   CAP_SYS_PTRACE        read /proc/<pid>/exe of any process, other
#                         users' included, and pid 1's root
#   CAP_DAC_READ_SEARCH   open and hash any executable, whatever its mode
#   CAP_NET_ADMIN         enforce mode: nft, the egress block
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_NET_ADMIN
NoNewPrivileges=yes
# BPF memory is charged to the cgroup on 6.x; this covers older loaders
# without handing out CAP_SYS_RESOURCE.
LimitMEMLOCK=infinity
UMask=0077

# Everything is read-only except state, the socket and the log dir.
ProtectSystem=strict
ReadWritePaths=/var/lib/aegis-v2 /run/aegis-v2
RuntimeDirectory=aegis-v2
RuntimeDirectoryMode=0700
# For the optional JSONL sink, if you point it at /var/log/aegis-v2.
LogsDirectory=aegis-v2
LogsDirectoryMode=0700

# Hardening that still lets aegisd see every process: ProtectProc stays
# at its default and there is no ProcSubset=pid. The private mount
# namespace these imply is fine: aegisd checks the inode each process
# executed against the file at that path under pid 1's root.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
# Every cgroup change in enforce mode goes through systemd over D-Bus.
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK for nft.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
